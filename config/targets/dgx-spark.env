# Live Hermes target profile for the DGX Spark (aitopatom-36a9).
#
# Do not store passwords, provider keys, OAuth tokens, or auth.json here.
# The DGX carries the dgx-jarvis identity in its DEFAULT profile (~/.hermes),
# so HERMES_CONFIG points at the default config, not at profiles/<name>/.

# Tailscale IP, with the user baked in. There is no ~/.ssh/config alias for this
# host, and the mDNS name (aitopatom-36a9.local) is the least reliable route.
# The user MUST be part of this value: bin/hermes-remote does `ssh $HERMES_REMOTE_HOST`
# and never prepends HERMES_REMOTE_USER, while install.sh/doctor.sh pass a
# bare host through `${USER}@${HOST}` only when it has no `@` already.
HERMES_REMOTE_HOST=bobeenlee@100.103.30.62
HERMES_REMOTE_USER=bobeenlee
HERMES_REMOTE_HOME=/home/bobeenlee
HERMES_REMOTE_OS=linux
HERMES_SERVICE_MANAGER=systemd
HERMES_COMPUTER_USE_BACKEND=cua-driver

HERMES_BIN=/home/bobeenlee/.local/bin/hermes
CUA_BIN=/home/bobeenlee/.local/bin/cua-driver

# Desktop for computer_use. This is the persistent GNOME X11 session xrdp keeps
# alive (sesman.ini: KillDisconnected=false, DisconnectedTimeLimit=0); gdm is
# stopped and seat0 holds no session, so :10 is the only desktop on this host.
HERMES_REMOTE_DISPLAY=:10
HERMES_REMOTE_XAUTHORITY=/home/bobeenlee/.Xauthority
HERMES_CONFIG=/home/bobeenlee/.hermes/config.yaml
HERMES_REMOTE_WORKSPACE=/home/bobeenlee/Workspaces/hermes-workspace
HERMES_WORKSPACE_REPO=https://github.com/BoBeenLee/hermes-workspace.git
HERMES_WORKSPACE_BRANCH=main

# The DGX account has no ~/.ssh/config entry, so the key is named explicitly.
HERMES_SSH_KEY=~/.ssh/id_ed25519_bobeenlee_nopass

# Local LLM: llama-local.service (systemd --user) serves llama.cpp on loopback
# 8080, model selected by ~/.local/bin/dgx-ai-control. Not vLLM, not port 8000.
HERMES_LLM_PROVIDER=custom:llama-local
HERMES_LLM_BASE_URL=http://127.0.0.1:8080/v1
HERMES_LLM_MODEL=qwen3.8-27b
HERMES_LLM_CONTEXT_LENGTH=65536
